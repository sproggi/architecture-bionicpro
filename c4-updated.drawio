                <mxCell id="c-shop" value="&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;Интернет-магазин&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Container: Битрикс24]&lt;/div&gt;&lt;div style=&quot;font-size:11px&quot;&gt;&lt;font color=&quot;#E6E6E6&quot;&gt;Каталог протезов, заказ и оплата&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1">
