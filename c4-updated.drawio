                <mxCell id="x-idp-n" value="&lt;font style=&quot;font-size:16px&quot;&gt;&lt;b&gt;IdP (страна N)&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[External System: OIDC Provider, PKCE S256]&lt;/div&gt;&lt;div style=&quot;font-size:11px&quot;&gt;&lt;font color=&quot;#cccccc&quot;&gt;Расширение на другие страны представительства (конфигурация в Country Router)&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;labelBackgroundColor=none;fillColor=#8C8C8C;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#5E5E5E;dashed=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1">
